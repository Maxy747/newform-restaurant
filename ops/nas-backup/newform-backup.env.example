# Copy to /etc/newform-backup.env on Dosimeter and lock it down:
#   sudo install -m 600 -o root -g root newform-backup.env.example /etc/newform-backup.env
# Never commit the filled-in copy.

# Supabase Dashboard -> Connect -> Session pooler. Paste the URL WITHOUT the password.
NEWFORM_DB_URL=postgresql://postgres.crlivalipmeypovsubca@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Database password (Dashboard -> Project Settings -> Database -> Reset database password if unknown).
NEWFORM_DB_PASSWORD=

# age PUBLIC key (starts with age1...). The matching private key stays offline, not on Dosimeter.
AGE_RECIPIENT=

# Folder on the mounted NASig share. The script refuses to run if this is on the local disk.
BACKUP_DIR=/mnt/nasig/backups/newform

# Days of daily backups to keep; the 1st-of-month backup is kept for MONTHLY_KEEP_DAYS.
RETENTION_DAYS=30
MONTHLY_KEEP_DAYS=365

# Mirror menu and gallery photos from the public buckets (leave empty to skip).
STORAGE_PUBLIC_URL=https://crlivalipmeypovsubca.supabase.co/storage/v1/object/public

# Daily request so the Free-plan project is never paused for inactivity (leave empty to skip).
KEEPALIVE_URL=https://crlivalipmeypovsubca.supabase.co/functions/v1/oms-api

# Optional: healthchecks.io ping URL (free) to get an email when a backup fails or does not run.
HEALTHCHECK_URL=
