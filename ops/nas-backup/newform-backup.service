[Unit]
Description=Newform database backup to NASig
Wants=network-online.target
After=network-online.target remote-fs.target

[Service]
Type=oneshot
EnvironmentFile=/etc/newform-backup.env
ExecStart=/usr/local/bin/newform-backup.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
